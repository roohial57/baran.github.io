{
  "liveServer.settings.root": "/website",
  "liveServer.settings.file": "/website/index.html",
  "liveServer.settings.port": 5500,
  "files.exclude": {
    "**/node_modules": true,
    "**/.astro": true,
    "**/dist": true,
    "**/src": true,
    "**/profile-site": true,
    "**/preview": true,
    "**/open": true
  },
  "javascript.validate.enable": false,
  "typescript.validate.enable": false,
  "html.validate.scripts": false,
  "css.validate": false
}
