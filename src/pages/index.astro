---
import { siteConfig } from "../config";
import "../styles/global.css";

const pageTitle = `${siteConfig.name} | ${siteConfig.title}`;
const canonical = siteConfig.url;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.url,
  jobTitle: siteConfig.title,
  description: siteConfig.description,
  email: siteConfig.email,
  sameAs: [siteConfig.social.github, siteConfig.social.linkedin],
};
const skillLine = `[ ${siteConfig.heroSkills.join(", ")}... ]`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav" id="nav">
        <a class="brand" href="#home"
          >{siteConfig.name} <span>| {siteConfig.title}</span></a
        >
        <ul class="nav-links">
          <li><a href="#home">Home</a></li>
          <li><a href="#about">About me</a></li>
          <li><a href="#portfolio">Portfolio</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
        <div class="nav-actions">
          <a class="btn btn-primary" href="#contact">Contact me</a>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label="Open menu">☰</button>
      </div>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="container hero-inner reveal">
          <h1>{siteConfig.title}</h1>
          <p class="hero-skills">{skillLine}</p>
          <p class="hero-bio">{siteConfig.heroBio}</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#portfolio">See my work</a>
            <a class="btn btn-outline" href={siteConfig.cvUrl} target="_blank" rel="noopener"
              >Download CV</a
            >
          </div>
          <svg
            class="hero-art"
            viewBox="0 0 640 220"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect x="40" y="40" width="560" height="120" rx="16" stroke="#00C2FF" stroke-opacity="0.55" stroke-width="2"></rect>
            <rect x="70" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="128" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="186" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="244" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="302" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="360" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="418" y="70" width="42" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <rect x="476" y="70" width="84" height="28" rx="6" fill="#00C2FF" fill-opacity="0.28" stroke="#00C2FF"></rect>
            <rect x="70" y="114" width="420" height="28" rx="6" fill="#00C2FF" fill-opacity="0.12" stroke="#00C2FF"></rect>
            <rect x="510" y="114" width="50" height="28" rx="6" fill="#00C2FF" fill-opacity="0.18" stroke="#00C2FF"></rect>
            <path d="M480 180h90v18a12 12 0 0 1-12 12h-66a12 12 0 0 1-12-12v-18z" stroke="#00C2FF" stroke-opacity="0.7"></path>
            <circle cx="525" cy="189" r="5" fill="#00C2FF"></circle>
          </svg>
        </div>
      </section>

      <section class="section" id="about">
        <div class="container about-grid">
          <div class="reveal">
            <div class="section-head">
              <h2>
                Problem solver <span>&lt;coder&gt;</span>
              </h2>
              <p>{siteConfig.aboutSubtitle}</p>
            </div>
            <ul class="about-list">
              {
                siteConfig.aboutPoints.map((point) => (
                  <li>
                    <span class="check" aria-hidden="true">
                      ✓
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="about-photo reveal">
            <div class="mono-label">
              {siteConfig.shortName}
              <br />
              .NET / Backend
              <br />
              Tehran
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="skills">
        <div class="container">
          <div class="section-head reveal">
            <h2>Tech stack</h2>
            <p>Tools I use to design, build, and ship backend systems.</p>
          </div>
          <div class="tech-grid">
            {
              siteConfig.techStack.map((tech) => (
                <article class="tech-card reveal">
                  <div class="tech-icon">{tech.name.slice(0, 2).toUpperCase()}</div>
                  <h3>{tech.name}</h3>
                  <p>{tech.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="portfolio">
        <div class="container">
          <div class="section-head reveal">
            <h2>My <span>{"{dev}"}</span> projects</h2>
            <p>Selected tools, boilerplates, and experiments from my GitHub.</p>
          </div>
          <div class="project-tabs reveal" role="tablist">
            <button class="tab active" data-filter="all">All</button>
            <button class="tab" data-filter="tools">Tools</button>
            <button class="tab" data-filter="apps">Apps</button>
          </div>
          <div class="project-grid" id="projectGrid">
            {
              siteConfig.projects.map((project) => (
                <article class="project-card reveal" data-category={project.category}>
                  <div class="project-visual">{`</${project.name.split(" ")[0]}>`}</div>
                  <div class="project-body">
                    <div class="project-stack">{project.stack}</div>
                    <h3>{project.name}</h3>
                    <p>{project.description}</p>
                    <div class="project-links">
                      {project.live ? (
                        <a href={project.live} target="_blank" rel="noopener">
                          See live
                        </a>
                      ) : null}
                      <a href={project.github} target="_blank" rel="noopener">
                        See on GitHub
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="container contact-wrap reveal">
          <div class="section-head">
            <h2>Let's <span>[work]</span> together</h2>
            <p>Open to full-time, remote jobs, or freelance backend projects.</p>
          </div>
          <form class="contact-form" action={`mailto:${siteConfig.email}`} method="get">
            <div class="field">
              <label for="name">Your Name</label>
              <input id="name" name="subject" type="text" placeholder="Your name" required />
            </div>
            <div class="field">
              <label for="email">Your Email</label>
              <input id="email" name="email" type="email" placeholder="you@email.com" required />
            </div>
            <div class="field">
              <label for="message">Your message</label>
              <textarea id="message" name="body" placeholder="Tell me about the role or project" required
              ></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Send Message</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <div>© {new Date().getFullYear()} {siteConfig.name}</div>
        <div class="footer-links">
          <a href={siteConfig.social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${siteConfig.email}`}>Email</a>
        </div>
      </div>
    </footer>

    <script>
      const nav = document.getElementById("nav");
      const toggle = document.getElementById("navToggle");
      toggle?.addEventListener("click", () => nav?.classList.toggle("open"));

      const tabs = document.querySelectorAll(".tab");
      const cards = document.querySelectorAll(".project-card");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
          const filter = tab.getAttribute("data-filter");
          cards.forEach((card) => {
            const category = card.getAttribute("data-category");
            const show = filter === "all" || filter === category;
            card.style.display = show ? "" : "none";
          });
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("visible");
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
